# Copier vers .env et adapter.

# URL de la plateforme CIBLE (le poste Hôte) :
#  - test en local (même machine)        : http://host.docker.internal:8080
#  - depuis le PC Attaquant vers l'Hôte   : http://192.168.137.1:8080
TARGET_URL=http://host.docker.internal:8080

# Adresse du poste Hôte pour les liens de supervision (cockpit, Grafana) :
#  - local : localhost        - en labo : 192.168.137.1
TARGET_HOST=localhost

# Port local de la console attaquant
ATTACKER_PORT=8090
