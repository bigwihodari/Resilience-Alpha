# Bascule automatique : le principal est utilisé en priorité ; si injoignable,
# nginx route vers le backup. Les clés d'idempotence rendent le ré-essai sûr
# (pas de double débit) -> non_idempotent autorisé pour /api.
# Tolérant aux à-coups : sur un poste unique chargé (client + hôte + IA locale),
# une requête lente ne doit PAS éjecter le serveur et faire « mourir » l'interface.
upstream api_up {
    server ${HOST_PRIMARY}:${HOST_PRIMARY_API_PORT} max_fails=5 fail_timeout=5s;
    server ${HOST_BACKUP}:${HOST_BACKUP_API_PORT} backup;
}
upstream auth_up {
    server ${HOST_PRIMARY}:${HOST_PRIMARY_AUTH_PORT} max_fails=5 fail_timeout=5s;
    server ${HOST_BACKUP}:${HOST_BACKUP_AUTH_PORT} backup;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location /auth/ {
        proxy_pass http://auth_up/;
        # On ne bascule que si le serveur est vraiment injoignable (pas sur un 503
        # applicatif volontaire, ni sur une simple lenteur).
        proxy_next_upstream error timeout http_502 http_504;
        proxy_connect_timeout 4s;
        proxy_read_timeout 20s;
        proxy_send_timeout 20s;
        proxy_set_header Host $host;
    }
    location /api/ {
        proxy_pass http://api_up/;
        proxy_next_upstream error timeout http_502 http_504 non_idempotent;
        proxy_connect_timeout 4s;
        proxy_read_timeout 20s;
        proxy_send_timeout 20s;
        proxy_set_header Host $host;
    }
    # WebSocket temps réel (mise à jour live des soldes) + bascule backup
    location /ws {
        proxy_pass http://api_up/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_next_upstream error timeout http_502 http_504;
        proxy_connect_timeout 4s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_set_header Host $host;
    }
    location / { try_files $uri $uri/ /index.html; }
}
