# Proxy vers le serveur HOST. En P14, cet upstream recevra aussi le backup.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location /auth/ {
        proxy_pass http://${HOST_PRIMARY}:8001/;
        proxy_connect_timeout 2s;
        proxy_set_header Host $host;
    }
    location /api/ {
        proxy_pass http://${HOST_PRIMARY}:8000/;
        proxy_connect_timeout 2s;
        proxy_set_header Host $host;
    }
    location / { try_files $uri $uri/ /index.html; }
}
