# Copier vers .env et adapter.

# --- Serveur principal ---
#  - test local (même machine) : host.docker.internal
#  - en labo vers le PC Hôte    : 192.168.137.1
HOST_PRIMARY=host.docker.internal
HOST_PRIMARY_API_PORT=8000
HOST_PRIMARY_AUTH_PORT=8001

# --- Serveur de secours (bascule automatique) ---
#  - en labo (2e PC, stack complète) : 192.168.137.2  (ports 8000/8001)
#  - test local (compose backup)     : host.docker.internal (ports 8010/8011)
HOST_BACKUP=host.docker.internal
HOST_BACKUP_API_PORT=8010
HOST_BACKUP_AUTH_PORT=8011

# Port local de l'app client
CLIENT_PORT=8095
