# Copier vers .env et adapter. NE JAMAIS committer .env (voir .gitignore).
POSTGRES_USER=resilience
POSTGRES_PASSWORD=resilience
POSTGRES_DB=resilience

# Secret partagé pour signer/vérifier les JWT (auth <-> api).
# En production : géré via SOPS/Vault (phase Cyber). Ici valeur de dev.
JWT_SECRET=dev-secret-change-me

# Token d'admin scoped : seul l'orchestrateur peut activer/désactiver le bouclier.
ADMIN_TOKEN=orchestrator-admin-token
# Token des clients internes de confiance (canari, trafic légitime) : exemptés du bouclier.
INTERNAL_TOKEN=internal-trusted-token

# Token interne de réplication principal <-> backup.
REPL_TOKEN=repl-secret

# --- Haute disponibilité (cockpit "Haute-Dispo", bascule principal <-> secours) ---
# HA_NAME : nom affiche du noeud (PRINCIPAL par defaut sur le host principal).
HA_NAME=PRINCIPAL
# PEER_API_URL : URL de l'api du SECOURS, pour afficher les deux cartes du cluster.
#   - test local (docker-compose.backup.yml sur la meme machine) : http://host.docker.internal:8010
#   - labo 2 PC : http://<IP-du-PC-secours>:8000  (ex. http://192.168.137.2:8000)
#   - laisser vide si pas de secours.
PEER_API_URL=
# Secours pour la bascule du COCKPIT (le cockpit reste vivant si le principal tombe).
#   - test local : HOST_BACKUP=host.docker.internal, ports 8010/8011
#   - labo 2 PC  : HOST_BACKUP=<IP-du-PC-secours>, ports 8000/8001
#   - defaut (api/8000) = pas de secours (no-op, conf valide).
HOST_BACKUP=api
HOST_BACKUP_API_PORT=8000
HOST_BACKUP_AUTH_PORT=8000
# Ports du secours en TEST LOCAL (docker-compose.backup.yml).
API_BACKUP_PORT=8010
AUTH_BACKUP_PORT=8011
# Pair du SECOURS en test local = le principal (defaut 8000). Laisser tel quel ;
# ne pas confondre avec PEER_API_URL ci-dessus (lui pointe vers le secours).
BACKUP_PEER_API_URL=http://host.docker.internal:8000

# Modele LLM local (Ollama) pour l'assistant RAG (<= 8B, conforme au sujet).
LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
EMB_MODEL=nomic-embed-text

# Compte de démonstration (créé au démarrage du service auth).
DEMO_PASSWORD=password123

# Compte banquier (interface de gestion des comptes, côté host).
BANKER_USER=banquier
BANKER_PASSWORD=password123

# Identifiants Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Ports publiés sur l'hôte — à changer SEULEMENT en cas de conflit avec une
# autre application déjà lancée sur la machine (ex. un phpMyAdmin sur 8080/8081).
FRONTEND_PORT=8080
API_PORT=8000
AUTH_PORT=8001
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
LOKI_PORT=3100
