# Cockpit host : bascule automatique principal -> secours.
# Le principal est l'API locale (service `api`). Le secours (${HOST_BACKUP}) n'est
# utilisé que si le principal est injoignable -> le cockpit reste vivant pendant la
# panne et affiche la bascule. Les clés d'idempotence rendent le ré-essai sûr.
# Valeurs par défaut (compose) : HOST_BACKUP=api -> secours = principal (no-op) tant
# qu'aucun vrai host de secours n'est configuré, donc la conf reste toujours valide.
upstream api_up {
    server api:8000 max_fails=1 fail_timeout=3s;
    server ${HOST_BACKUP}:${HOST_BACKUP_API_PORT} backup;
}
upstream auth_up {
    server auth:8000 max_fails=1 fail_timeout=3s;
    server ${HOST_BACKUP}:${HOST_BACKUP_AUTH_PORT} backup;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Reverse-proxy vers les services internes (pas d'exposition directe).
    location /auth/ {
        proxy_pass http://auth_up/;
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_connect_timeout 2s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
    location /api/ {
        proxy_pass http://api_up/;
        proxy_next_upstream error timeout http_502 http_503 http_504 non_idempotent;
        proxy_connect_timeout 2s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
    # WebSocket temps réel (mise à jour live des soldes) + bascule secours
    location /ws {
        proxy_pass http://api_up/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_connect_timeout 2s;
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }
    # Prometheus (lecture seule) pour alimenter les graphes DANS l'app.
    location /prom/ {
        proxy_pass http://prometheus:9090/;
        proxy_set_header Host $host;
    }
    # Orchestrateur de remédiation (état + timeline) pour le cockpit.
    location /orch/ {
        proxy_pass http://orchestrator:8000/;
        proxy_set_header Host $host;
    }
    # Assistant RAG (réponses du LLM local : timeout large).
    location /assistant/ {
        proxy_pass http://assistant:8000/;
        proxy_set_header Host $host;
        proxy_read_timeout 180s;
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }
}
