# === Resilience Guard — configuration de l'overlay ===
# Copier en .env puis ajuster (au minimum PROTECTED_UPSTREAM).
#   cp .env.example .env

# --- Application à protéger (reverse-proxy de la passerelle) ---
# Dockerisée et sur le MEME reseau que l'overlay : http://mon-app:8000
# Sinon (app non dockerisée, ou autre compose qui publie un port) : host.docker.internal.
# Par défaut : la démo « vitrine » qui publie le port 8090 (voir demo-apps/).
PROTECTED_UPSTREAM=http://host.docker.internal:8090

# --- Ports publiés sur l'hôte ---
GATEWAY_PORT=8080
COCKPIT_PORT=8088
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100

# --- Sécurité / tokens ---
# Token de l'API d'administration scoped de la passerelle (bouclier /admin/protect).
ADMIN_TOKEN=orchestrator-admin-token
# Token interne de confiance (réservé, parité avec la plateforme d'origine).
INTERNAL_TOKEN=internal-trusted-token

# --- Bouclier anti-DoS (load-shedding) : débit autorisé quand le bouclier est actif ---
SHED_RATE=8.0
# Délai d'attente du proxy vers l'amont (secondes).
UPSTREAM_TIMEOUT=15

# --- Détecteur ML ---
WARMUP_SAMPLES=30

# --- Assistant RAG (Ollama local sur l'hôte) ---
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
EMB_MODEL=nomic-embed-text

# --- Grafana ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
